<UserControl x:Class="PUPlayer.App.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PUPlayer.App.Views"
             xmlns:settings="clr-namespace:PUPlayer.Core.Settings;assembly=PUPlayer.Core"
             AllowDrop="True" PreviewDragOver="Workspace_DragOver" Drop="Workspace_Drop" Background="{DynamicResource CanvasBrush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border x:Name="TopBar" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True" Margin="8,4">
                <ToggleButton x:Name="SettingsToggle" DockPanel.Dock="Right" Style="{DynamicResource CarbonToggleButton}" Content="{DynamicResource Settings}" ToolTip="{DynamicResource Settings}" AutomationProperties.Name="{DynamicResource Settings}"/>
                <Popup x:Name="SettingsPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=SettingsToggle}" VerticalOffset="5" IsOpen="{Binding IsChecked, ElementName=SettingsToggle, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True">
                    <Border Width="340" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource Language}" Style="{DynamicResource MutedText}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Style="{DynamicResource CarbonComboBox}" SelectedValue="{Binding Settings.Language, Mode=TwoWay}" SelectedValuePath="Tag"><ComboBoxItem Content="{DynamicResource English}" Tag="en"/><ComboBoxItem Content="{DynamicResource Spanish}" Tag="es"/></ComboBox>
                                <TextBlock Grid.Row="1" Text="{DynamicResource VisualPreset}" Style="{DynamicResource MutedText}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" Style="{DynamicResource CarbonComboBox}" SelectedValue="{Binding Settings.ThemePreset, Mode=TwoWay}" SelectedValuePath="Tag"><ComboBoxItem Content="Carbon Blue" Tag="{x:Static settings:ThemePreset.CarbonBlue}"/><ComboBoxItem Content="Midnight Soft" Tag="{x:Static settings:ThemePreset.MidnightSoft}"/><ComboBoxItem Content="Graphite Compact" Tag="{x:Static settings:ThemePreset.GraphiteCompact}"/><ComboBoxItem Content="Custom" Tag="{x:Static settings:ThemePreset.Custom}" IsEnabled="False"/></ComboBox>
                                <TextBlock Grid.Row="2" Text="{DynamicResource AccentColor}" Style="{DynamicResource MutedText}" VerticalAlignment="Center"/>
                                <TextBox x:Name="AccentInput" Grid.Row="2" Grid.Column="1" Text="{Binding Settings.AccentColor, Mode=OneWay}" LostKeyboardFocus="AccentInput_LostKeyboardFocus" Background="{DynamicResource ControlBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="8,6" Margin="3" MaxLength="7"/>
                                <TextBlock Grid.Row="3" Text="{DynamicResource ButtonShape}" Style="{DynamicResource MutedText}" VerticalAlignment="Center"/>
                                <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="20" Value="{Binding Settings.ButtonCornerRadius, Mode=TwoWay}" Style="{DynamicResource CarbonSlider}" Margin="8"/>
                                <TextBlock Grid.Row="4" Text="{DynamicResource ControlHeightLabel}" Style="{DynamicResource MutedText}" VerticalAlignment="Center"/>
                                <Slider Grid.Row="4" Grid.Column="1" Minimum="28" Maximum="40" Value="{Binding Settings.ControlHeight, Mode=TwoWay}" Style="{DynamicResource CarbonSlider}" Margin="8"/>
                                <TextBlock Grid.Row="5" Text="{DynamicResource Density}" Style="{DynamicResource MutedText}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="5" Grid.Column="1" Style="{DynamicResource CarbonComboBox}" SelectedValue="{Binding Settings.Density, Mode=TwoWay}" SelectedValuePath="Tag"><ComboBoxItem Content="{DynamicResource Compact}" Tag="{x:Static settings:ControlDensity.Compact}"/><ComboBoxItem Content="{DynamicResource Comfortable}" Tag="{x:Static settings:ControlDensity.Comfortable}"/></ComboBox>
                            </Grid>
                            <TextBlock x:Name="SettingsError" Foreground="{DynamicResource ErrorBrush}" Margin="3,6,3,0" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="{DynamicResource RestorePreset}" Click="RestorePreset_Click" Style="{DynamicResource CarbonButton}"/><Button Content="{DynamicResource Preview}" IsHitTestVisible="False" Style="{DynamicResource CarbonPrimaryButton}"/></StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
                <Button DockPanel.Dock="Right" Style="{DynamicResource CarbonButton}" Click="ToggleLayout_Click" ToolTip="{DynamicResource LayoutTip}" AutomationProperties.Name="{DynamicResource Layout}">
                    <StackPanel Orientation="Horizontal"><Grid Width="18" Height="16" Margin="0,0,7,0"><Rectangle Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" RadiusX="2" RadiusY="2"/><Line X1="9" Y1="1" X2="9" Y2="15" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4"/></Grid><TextBlock Text="{DynamicResource Layout}" VerticalAlignment="Center"/></StackPanel>
                </Button>
                <ToggleButton x:Name="GlobalCacheToggle" DockPanel.Dock="Right" Style="{DynamicResource CarbonToggleButton}" Content="{Binding GlobalCacheStatus}" Click="GlobalCache_Open" ToolTip="{DynamicResource GlobalCacheTip}" AutomationProperties.Name="{DynamicResource GlobalCacheTip}"/>
                <Popup Placement="Bottom" PlacementTarget="{Binding ElementName=GlobalCacheToggle}" VerticalOffset="5" IsOpen="{Binding IsChecked, ElementName=GlobalCacheToggle, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True">
                    <Border Width="300" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14"><StackPanel><TextBlock Text="{DynamicResource GlobalCache}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{DynamicResource CacheDescription}" Style="{DynamicResource MutedText}" Margin="0,4,0,9"/><WrapPanel><Button Content="{DynamicResource Refresh}" Click="GlobalCache_Refresh" Style="{DynamicResource CarbonButton}"/><Button Content="{DynamicResource DeleteAudio}" Click="GlobalCache_DeleteAudio" Style="{DynamicResource CarbonButton}"/><Button Content="{DynamicResource DeleteAll}" Click="GlobalCache_DeleteAll" Style="{DynamicResource CarbonButton}"/></WrapPanel></StackPanel></Border>
                </Popup>
                <StackPanel x:Name="BrandWordmark" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,20,0"><Image Source="/IgoonTube;component/Assets/IgoonTube.png" Width="32" Height="32" Margin="0,0,9,0"/><TextBlock FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"><Run Text="I" Foreground="{DynamicResource BrandWhiteBrush}"/><Run Text="goon" Foreground="{DynamicResource BrandBlueBrush}"/><Run Text="Tube" Foreground="{DynamicResource BrandWhiteBrush}"/></TextBlock></StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource DropSecondVideo}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid x:Name="PanelsHost"/>
            <Border Background="{DynamicResource CanvasBrush}">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Panels.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"><Border Width="54" Height="54" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center" Margin="0,0,0,16"><Path Data="M 16 11 L 38 27 L 16 43 Z" Fill="{DynamicResource AccentBrush}" Stretch="None"/></Border><TextBlock Text="{DynamicResource DropVideoHere}" Foreground="{DynamicResource TextBrush}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource LocalOnly}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0" HorizontalAlignment="Center"/></StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
