<UserControl x:Class="PUPlayer.App.Views.PlayerPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:playback="clr-namespace:PUPlayer.App.Playback"
             xmlns:views="clr-namespace:PUPlayer.App.Views"
             Background="{DynamicResource CanvasBrush}" Focusable="True">
    <UserControl.Resources><views:MarkerPositionConverter x:Key="MarkerPosition"/></UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="ControlsRow" Height="Auto"/>
        </Grid.RowDefinitions>
        <Border x:Name="HeaderBar" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True" Margin="7,3">
                <Button DockPanel.Dock="Right" Style="{DynamicResource CarbonIconButton}" Click="Close_Click"
                        ToolTip="{DynamicResource CloseVideo}" AutomationProperties.Name="{DynamicResource CloseVideo}">
                    <Path Data="M 3 3 L 13 13 M 13 3 L 3 13" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
                <Border DockPanel.Dock="Right" Background="#18353D" BorderBrush="#397583" BorderThickness="1" CornerRadius="7" Padding="8,4" Margin="5,0">
                    <TextBlock Text="{Binding ZoomScale, StringFormat={}{0:0.0}x}" Foreground="{DynamicResource AccentHoverBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Border>
                <Grid Margin="5,0,8,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}"/>
                    <TextBlock Grid.Column="2" Text="{Binding DisplayName}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Background="Black">
            <playback:MpvSurface x:Name="Surface" HandleReady="Surface_HandleReady"/>
            <Border x:Name="LoadingOverlay" IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#CC14161A" CornerRadius="7" Padding="12,7">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style></Border.Style>
                <TextBlock Text="{Binding LoadStatus}" Foreground="{DynamicResource TextBrush}"/>
            </Border>
            <Canvas x:Name="CropCanvas" Background="#01000000" Cursor="Cross" PreviewMouseLeftButtonDown="Crop_Begin" PreviewMouseMove="Crop_Move" PreviewMouseLeftButtonUp="Crop_End">
                <Canvas.Style><Style TargetType="Canvas"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCropEditing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Canvas.Style>
                <Rectangle x:Name="CropRectangle" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Fill="#2269D2E7" Visibility="Collapsed"/>
                <Border Canvas.Left="12" Canvas.Top="12" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9,6"><TextBlock Text="{DynamicResource CropInstruction}" Foreground="{DynamicResource TextBrush}"/></Border>
            </Canvas>
        </Grid>
        <Border x:Name="ControlsBar" Grid.Row="2" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,7">
            <Grid x:Name="ControlLayout">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*" MinWidth="64"/><ColumnDefinition Width="2*" MinWidth="160"/><ColumnDefinition Width="Auto" MaxWidth="140"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding TimeLabel}" Style="{DynamicResource MutedText}" FontFamily="Consolas"/>
                <Grid Grid.Column="1" Margin="6,0">
                    <Slider x:Name="Timeline" Style="{DynamicResource CarbonSlider}"
                            Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=OneWay}" PreviewMouseLeftButtonUp="Timeline_Released" MouseMove="Timeline_MouseMove" MouseLeave="Timeline_MouseLeave"/>
                    <Popup x:Name="ThumbnailPopup" Placement="Top" PlacementTarget="{Binding ElementName=Timeline}" VerticalOffset="-8" AllowsTransparency="True" StaysOpen="True"><Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="5"><StackPanel><Image x:Name="ThumbnailImage" Width="192" Height="108" Stretch="UniformToFill"/><TextBlock x:Name="ThumbnailTime" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Border></Popup>
                    <ItemsControl ItemsSource="{Binding SceneMarkers}" IsHitTestVisible="False" VerticalAlignment="Center" Height="12">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left"><Setter.Value><MultiBinding Converter="{StaticResource MarkerPosition}"><Binding Path="Seconds"/><Binding Path="DataContext.DurationSeconds" RelativeSource="{RelativeSource AncestorType=UserControl}"/><Binding Path="ActualWidth" ElementName="Timeline"/></MultiBinding></Setter.Value></Setter></Style></ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate><DataTemplate><Rectangle Width="2" Height="9" Fill="{DynamicResource AccentBrush}" RadiusX="1"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <TextBlock Grid.Column="3" Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <ScrollViewer Grid.Column="2" Margin="8,0,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False">
                    <StackPanel x:Name="ControlStrip" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{DynamicResource CarbonIconButton}" Click="Back_Click" ToolTip="{DynamicResource Back10}" AutomationProperties.Name="{DynamicResource Back10}">
                            <Path Data="M 11 3 L 5 8 L 11 13" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <Button Style="{DynamicResource CarbonPrimaryButton}" Click="PlayPause_Click" ToolTip="{DynamicResource PlayPause}" AutomationProperties.Name="{DynamicResource PlayPause}" Width="42">
                            <Grid Width="18" Height="14"><Path Data="M 0 0 L 8 7 L 0 14 Z" Fill="#0B171A" HorizontalAlignment="Left"/><Rectangle Width="2.3" Height="13" Fill="#0B171A" HorizontalAlignment="Right" Margin="0,0,4,0"/><Rectangle Width="2.3" Height="13" Fill="#0B171A" HorizontalAlignment="Right"/></Grid>
                        </Button>
                        <Button Style="{DynamicResource CarbonIconButton}" Click="Forward_Click" ToolTip="{DynamicResource Forward10}" AutomationProperties.Name="{DynamicResource Forward10}">
                            <Path Data="M 5 3 L 11 8 L 5 13" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}" Margin="5,0,8,0"/>
                        <Grid Width="16" Height="16" VerticalAlignment="Center" ToolTip="{DynamicResource Volume}">
                            <Path Data="M 1 6 L 5 6 L 9 2 L 9 14 L 5 10 L 1 10 Z" Fill="{DynamicResource MutedTextBrush}"/>
                            <Path Data="M 11 5 C 14 7 14 9 11 11" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                        </Grid>
                        <Slider x:Name="Volume" Width="88" Style="{DynamicResource CarbonSlider}" Margin="6,0" Minimum="0" Maximum="200" Value="{Binding VolumePercent, Mode=OneWay}" PreviewMouseLeftButtonUp="Volume_Released"/>
                        <TextBlock Text="{Binding VolumePercent, StringFormat={}{0:0}%}" Foreground="{DynamicResource TextBrush}" Width="38" VerticalAlignment="Center" FontFamily="Consolas"/>
                        <ComboBox x:Name="Speed" Width="68" Margin="3,0" Style="{DynamicResource CarbonComboBox}" VerticalAlignment="Center" ToolTip="{DynamicResource Speed}" SelectedIndex="2" SelectionChanged="Speed_Changed">
                            <ComboBoxItem Content="0.5x" Tag="0.5"/><ComboBoxItem Content="0.75x" Tag="0.75"/>
                            <ComboBoxItem Content="1x" Tag="1"/><ComboBoxItem Content="1.25x" Tag="1.25"/>
                            <ComboBoxItem Content="1.5x" Tag="1.5"/><ComboBoxItem Content="2x" Tag="2"/>
                        </ComboBox>
                        <ComboBox x:Name="AudioPreset" Width="118" Margin="3,0" Style="{DynamicResource CarbonComboBox}" VerticalAlignment="Center" ToolTip="{DynamicResource AudioProfile}" SelectedIndex="0" SelectionChanged="AudioPreset_Changed">
                            <ComboBoxItem Content="{DynamicResource OriginalAudio}" Tag="Natural"/>
                            <ComboBoxItem Content="{DynamicResource ClearVoice}" Tag="Voice"/>
                            <ComboBoxItem Content="{DynamicResource IntimateAsmr}" Tag="Intimate"/>
                            <ComboBoxItem Content="{DynamicResource DetailedIntimate}" Tag="DetailedIntimate"/>
                            <ComboBoxItem Content="{DynamicResource ReduceNoise}" Tag="Denoise"/>
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding AiFeaturesVisibility}">
                        <ToggleButton Style="{DynamicResource CarbonToggleButton}" Margin="3,0" Padding="9,5"
                                      IsChecked="{Binding IsTracking, Mode=OneWay}" Click="Tracking_Click"
                                      ToolTip="{Binding TrackingStatus}" AutomationProperties.Name="{DynamicResource FollowSubject}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 2 8 C 5 3 11 3 14 8 C 11 13 5 13 2 8 Z M 6 8 A 2 2 0 1 0 10 8 A 2 2 0 1 0 6 8"
                                      Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform"/>
                                <TextBlock Text="{DynamicResource Follow}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <TextBlock Text="{Binding TrackingStatus}" Style="{DynamicResource MutedText}" MaxWidth="145"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="5,0"/>
                        </StackPanel>
                        <ToggleButton x:Name="ManualAudioToggle" Style="{DynamicResource CarbonToggleButton}" Margin="3,0" ToolTip="{DynamicResource ManualAudio}" AutomationProperties.Name="{DynamicResource ManualAudio}">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="16" Height="16" Margin="0,0,7,0">
                                    <Path Data="M 1 4 L 15 4 M 1 12 L 15 12" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.5"/>
                                    <Path Data="M 6 1 L 6 7 M 12 9 L 12 15" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"/>
                                </Grid>
                                <TextBlock Text="{DynamicResource Settings}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="ToolsToggle" Style="{DynamicResource CarbonToggleButton}" Margin="3,0" Content="{DynamicResource Tools}" ToolTip="{DynamicResource ToolsTip}" AutomationProperties.Name="Abrir herramientas del video"/>
                        <Popup Placement="Top" PlacementTarget="{Binding ElementName=ToolsToggle}" VerticalOffset="-6" IsOpen="{Binding IsChecked, ElementName=ToolsToggle, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True">
                            <Border Width="390" MaxHeight="590" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource VideoTools}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                                    <Expander Header="{DynamicResource Clip}" IsExpanded="True" Foreground="{DynamicResource TextBrush}" Style="{DynamicResource CarbonExpander}"><StackPanel Margin="0,8,0,10">
                                        <TextBlock Text="{Binding ClipLabel}" Style="{DynamicResource MutedText}" Margin="3,0,0,6"/>
                                        <WrapPanel><Button Content="{DynamicResource MarkA}" Click="ClipStart_Click" Style="{DynamicResource CarbonButton}"/><Button Content="{DynamicResource MarkB}" Click="ClipEnd_Click" Style="{DynamicResource CarbonButton}"/><Button Content="{DynamicResource Clear}" Click="ClipClear_Click" Style="{DynamicResource CarbonButton}"/></WrapPanel>
                                        <TextBlock Text="{DynamicResource Output}" Style="{DynamicResource MutedText}" Margin="3,8,0,3"/>
                                        <WrapPanel><Button Content="{DynamicResource QuickOriginal}" Click="ClipOriginal_Click" Style="{DynamicResource CarbonButton}"/><Button Content="{DynamicResource ApplyView}" Click="ClipView_Click" Style="{DynamicResource CarbonButton}"/></WrapPanel>
                                        <TextBlock Text="{Binding ClipModeLabel}" Foreground="{DynamicResource AccentHoverBrush}" Margin="3,3,0,0"/>
                                        <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding ExportProgress, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}" Margin="3,8"/>
                                        <TextBlock Text="{Binding ExportStatus}" Style="{DynamicResource MutedText}" Margin="3,0,0,4"/>
                                        <WrapPanel><Button Content="{DynamicResource ExportClip}" Click="ExportClip_Click" Style="{DynamicResource CarbonPrimaryButton}"/><Button Content="{DynamicResource Cancel}" Click="CancelClip_Click" Style="{DynamicResource CarbonButton}"/></WrapPanel>
                                    </StackPanel></Expander>
                                    <Expander Header="{DynamicResource Image}" Foreground="{DynamicResource TextBrush}" Style="{DynamicResource CarbonExpander}"><StackPanel Margin="0,8,0,10">
                                        <WrapPanel><Button Content="{DynamicResource RotateLeft}" Click="RotateLeft_Click" Style="{DynamicResource CarbonButton}"/><Button Content="{DynamicResource RotateRight}" Click="RotateRight_Click" Style="{DynamicResource CarbonButton}"/></WrapPanel>
                                        <WrapPanel><Button Content="{DynamicResource MirrorHorizontal}" Click="MirrorX_Click" Style="{DynamicResource CarbonButton}"/><Button Content="{DynamicResource MirrorVertical}" Click="MirrorY_Click" Style="{DynamicResource CarbonButton}"/></WrapPanel>
                                        <WrapPanel><Button Content="{DynamicResource CustomCrop}" Click="Crop_Click" Style="{DynamicResource CarbonPrimaryButton}"/><Button Content="{DynamicResource Reset}" Click="ResetGeometry_Click" Style="{DynamicResource CarbonButton}"/></WrapPanel>
                                    </StackPanel></Expander>
                                    <TextBlock Text="{DynamicResource FavoritesMarkers}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,0"/>
                                    <StackPanel Visibility="{Binding AiFeaturesVisibility}">
                                    <TextBlock Text="{Binding SceneStatus}" Style="{DynamicResource MutedText}" Margin="0,3,0,8"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="74"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Sensitivity}" Style="{DynamicResource MutedText}"/><Slider Grid.Column="1" Style="{DynamicResource CarbonSlider}" Margin="6,0" Minimum="0" Maximum="1" Value="{Binding SceneSensitivity, Mode=TwoWay}"/><TextBlock Grid.Column="2" Text="{Binding SceneSensitivity, StringFormat={}{0:0.0}}" Style="{DynamicResource MutedText}" HorizontalAlignment="Right"/></Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,8">
                                        <Button Content="{DynamicResource AnalyzeScenes}" Click="AnalyzeScenes_Click" Style="{DynamicResource CarbonPrimaryButton}"/>
                                        <Button Content="{DynamicResource Cancel}" Click="CancelScenes_Click" Style="{DynamicResource CarbonButton}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    </StackPanel>
                                    <Button Content="{DynamicResource AddFavorite}" Click="AddFavorite_Click" Style="{DynamicResource CarbonButton}" HorizontalAlignment="Left" Margin="0,0,0,8" ToolTip="{DynamicResource SaveMarker}"/>
                                    <ListBox x:Name="MarkerList" ItemsSource="{Binding SceneMarkers}" SelectionChanged="SceneMarker_Selected" MaxHeight="180" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}">
                                        <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="3"><TextBlock Text="{Binding Label}" Width="160"/><TextBlock Text="{Binding Seconds, StringFormat={}{0:0.0} s}" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Content="{DynamicResource RemoveFavorite}" Click="RemoveFavorite_Click" Style="{DynamicResource CarbonButton}" HorizontalAlignment="Left"/>
                                    <Expander Header="{DynamicResource Cache}" Foreground="{DynamicResource TextBrush}" Style="{DynamicResource CarbonExpander}" Margin="0,8,0,0"><StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="{Binding CacheStatus}" Style="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="3,0,0,6"/>
                                        <WrapPanel><Button Content="{DynamicResource Calculate}" Click="RefreshCache_Click" Style="{DynamicResource CarbonButton}"/><Button Content="{DynamicResource DeleteAudio}" Click="DeleteAudioCache_Click" Style="{DynamicResource CarbonButton}"/><Button Content="{DynamicResource DeleteThumbnails}" Click="DeleteThumbnailCache_Click" Style="{DynamicResource CarbonButton}"/><Button Content="{DynamicResource DeleteAnalysis}" Click="DeleteAnalysisCache_Click" Style="{DynamicResource CarbonButton}"/></WrapPanel>
                                    </StackPanel></Expander>
                                </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                        <Popup x:Name="ManualAudioPopup" Placement="Top" PlacementTarget="{Binding ElementName=ManualAudioToggle}" VerticalOffset="-6"
                               IsOpen="{Binding IsChecked, ElementName=ManualAudioToggle, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True">
                            <Border Width="330" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource ManualAdjustment}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>
                                    <TextBlock Text="{DynamicResource LoopAB}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding LoopLabel}" Style="{DynamicResource MutedText}" Margin="0,3,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Content="{DynamicResource MarkA}" Click="LoopStart_Click" Style="{DynamicResource CarbonButton}"/>
                                        <Button Content="{DynamicResource MarkB}" Click="LoopEnd_Click" Style="{DynamicResource CarbonButton}" Margin="6,0,0,0"/>
                                        <Button Content="{DynamicResource Clear}" Click="LoopClear_Click" Style="{DynamicResource CarbonButton}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,10"/>
                                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Cutoff}" Style="{DynamicResource MutedText}"/><Slider Grid.Column="1" Style="{DynamicResource CarbonSlider}" Margin="6,0" Minimum="0" Maximum="180" Value="{Binding LowCutHz, Mode=TwoWay}" PreviewMouseLeftButtonUp="ManualAudio_Released"/><TextBlock Grid.Column="2" Text="{Binding LowCutHz, StringFormat={}{0:0} Hz}" Style="{DynamicResource MutedText}" HorizontalAlignment="Right"/></Grid>
                                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Voice}" Style="{DynamicResource MutedText}"/><Slider Grid.Column="1" Style="{DynamicResource CarbonSlider}" Margin="6,0" Minimum="-12" Maximum="12" Value="{Binding VoiceGainDb, Mode=TwoWay}" PreviewMouseLeftButtonUp="ManualAudio_Released"/><TextBlock Grid.Column="2" Text="{Binding VoiceGainDb, StringFormat={}{0:0} dB}" Style="{DynamicResource MutedText}" HorizontalAlignment="Right"/></Grid>
                                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Detail}" Style="{DynamicResource MutedText}"/><Slider Grid.Column="1" Style="{DynamicResource CarbonSlider}" Margin="6,0" Minimum="-12" Maximum="12" Value="{Binding PresenceGainDb, Mode=TwoWay}" PreviewMouseLeftButtonUp="ManualAudio_Released"/><TextBlock Grid.Column="2" Text="{Binding PresenceGainDb, StringFormat={}{0:0} dB}" Style="{DynamicResource MutedText}" HorizontalAlignment="Right"/></Grid>
                                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Noise}" Style="{DynamicResource MutedText}"/><Slider Grid.Column="1" Style="{DynamicResource CarbonSlider}" Margin="6,0" Minimum="0" Maximum="1" Value="{Binding Denoise, Mode=TwoWay}" PreviewMouseLeftButtonUp="ManualAudio_Released"/><TextBlock Grid.Column="2" Text="{Binding Denoise, StringFormat={}{0:0.00}}" Style="{DynamicResource MutedText}" HorizontalAlignment="Right"/></Grid>
                                    <CheckBox Content="{DynamicResource DynamicCompression}" Style="{DynamicResource CarbonCheckBox}" IsChecked="{Binding Compression, Mode=TwoWay}" Click="ManualAudio_Click"/>
                                    <StackPanel Visibility="{Binding AiFeaturesVisibility}">
                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12,0,10"/>
                                    <TextBlock Text="{DynamicResource AiVoice}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding AudioProcessingStatus}" Style="{DynamicResource MutedText}" Margin="0,3,0,8"/>
                                    <ProgressBar Height="3" IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}" Margin="0,0,0,8">
                                        <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsAudioProcessing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
                                    </ProgressBar>
                                    <StackPanel Orientation="Horizontal">
                                        <Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsAudioProcessing}" Value="False"/><Condition Binding="{Binding IsAiAudioActive}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Grid.Style><StackPanel><Button Content="{DynamicResource EnhanceVoiceAi}" Click="EnhanceVoice_Click" Style="{DynamicResource CarbonPrimaryButton}"/><Button Content="{DynamicResource EnhanceDetailAi}" Click="EnhanceDetail_Click" Style="{DynamicResource CarbonButton}"/></StackPanel></Grid>
                                        <Grid Margin="6,0,0,0"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsAudioProcessing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><Button Content="{DynamicResource Cancel}" Click="CancelVoice_Click" Style="{DynamicResource CarbonButton}"/></Grid>
                                        <Grid Margin="6,0,0,0"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsAiAudioActive}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><Button Content="{DynamicResource UseOriginalAudio}" Click="OriginalAudio_Click" Style="{DynamicResource CarbonButton}"/></Grid>
                                    </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
